# AEGF Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Vault Master Key (Optional): 64-character hex AES-256 master key.
# If omitted, AEGF generates or loads vault.key with 0600 permissions.
# AEGF_VAULT_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Proxy Server Binding (Default: 127.0.0.1:8080)
# AEGF_SERVER_LISTEN=127.0.0.1:8080

# Rust Inference Service Address (Default: 127.0.0.1:50051)
# AEGF_INFERENCE_ADDRESS=127.0.0.1:50051

# SQLite Database Paths
# AEGF_VAULT_DB=data/vault.db
# AEGF_AUDIT_DB=data/audit.db
